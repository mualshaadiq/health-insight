{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/data.py": {
      "maxDuration": 60,
      "includeFiles": "{core.py,analysis.py,storage.py,garmin_client.py,demo_data.py,fit.py,run_detail.py,workouts.py,garmin_sync.py,api/_handler.py}"
    },
    "api/day.py": {
      "maxDuration": 60,
      "includeFiles": "{core.py,analysis.py,storage.py,garmin_client.py,demo_data.py,fit.py,run_detail.py,workouts.py,garmin_sync.py,api/_handler.py}"
    },
    "api/cron.py": {
      "maxDuration": 60,
      "includeFiles": "{core.py,analysis.py,storage.py,garmin_client.py,demo_data.py,fit.py,run_detail.py,workouts.py,garmin_sync.py,api/_handler.py}"
    },
    "api/workouts.py": {
      "maxDuration": 60,
      "includeFiles": "{core.py,analysis.py,storage.py,garmin_client.py,demo_data.py,fit.py,run_detail.py,workouts.py,garmin_sync.py,api/_handler.py}"
    },
    "api/garmin.py": {
      "maxDuration": 60,
      "includeFiles": "{core.py,analysis.py,storage.py,garmin_client.py,demo_data.py,fit.py,run_detail.py,workouts.py,garmin_sync.py,api/_handler.py}"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 22 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/((?!api/|web/).+)",
      "destination": "/web/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
